<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD polkit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/polkit/1/policyconfig.dtd">
<policyconfig>
  <vendor>univention-arch-connector contributors</vendor>
  <vendor_url>https://github.com/G5K-org/univention-arch-connector</vendor_url>
  <icon_name>network-server</icon_name>

  <action id="io.github.g5k-org.univention-arch-connector.run-gui">
    <description>Join this computer into a Univention Corporate Server (UCS) domain</description>
    <message>Authentication is required to join this computer into a domain</message>
    <icon_name>network-server</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/univention-arch-connector-gui</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
