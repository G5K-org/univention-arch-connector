# Maintainer: univention-arch-connector contributors
pkgname=univention-arch-connector-cli
pkgver=0.1.0
pkgrel=1
pkgdesc="CLI to join this Arch Linux client into a Univention Corporate Server (UCS) domain"
arch=('any')
url="https://github.com/G5K-org/univention-arch-connector"
license=('AGPL-3.0-only')
depends=(
  "python-univention-arch-connector=$pkgver"
  'sssd' 'krb5' 'sshpass' 'chrony' 'ca-certificates-utils' 'openldap' 'openssh' 'systemd'
)
optdepends=(
  'ntp: fallback one-shot time sync if chrony is not installed'
  'networkmanager: DNS backend used when systemd-resolved is not active'
)
source=("$pkgname-$pkgver.tar.gz::https://github.com/G5K-org/univention-arch-connector/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
  cd "univention-arch-connector-$pkgver"
  install -Dm755 scripts/cli.py "$pkgdir/usr/bin/univention-arch-connector-cli"
  install -d "$pkgdir/var/log/univention-arch-connector"
  install -Dm644 LICENSES/AGPL-3.0-only.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 NOTICE.md "$pkgdir/usr/share/licenses/$pkgname/NOTICE.md"
}
